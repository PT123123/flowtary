// Flowtary Slint UI — Raycast 风格启动器
// 只负责「画」：搜索逻辑、结果内容都在主进程（flowtary.exe）里；
// 渲染器通过共享内存桥拿到「文本 + 行列表」，把用户意图回传给主进程。
// 交互：TextInput 搜索（走平台 IME，支持中文）/ ↑↓ 选中 / 回车启动 / Esc 隐藏 / 点击行启动。
import { VerticalBox, HorizontalBox } from "std-widgets.slint";

struct ResultItem {
    title: string,
    sub: string,
    hotkey: string,   // 徽章字符（Alt+数字 / Alt+字母）；空 = 不显示
    usage-badge: string, // 使用次数徽章「×N」；空 = 不显示
    usage-tier: int,     // 0=原样 2=常用 3=高频 4=重度（与 GDI 版分档一致）
    kind: int,        // 与主程序 Row::Kind 对齐：0文件 1文件夹 2网页 3程序 4提示 5组 6命令 7窗口 8置顶 9截图 10定位
    icon: image,      // 由 C++ 侧 HICON -> RGBA 注入；空 image 时回退到文字徽标
    glyph: string,    // 图标未就绪时的文字回退（WEB/CMD/...）
    icon-bg: color,
}

struct MenuItem {
    label: string,
    is-default: bool,
}

// 别名输入卡片：铺满启动器窗口（含压暗层 + 居中卡片）
component AliasCard inherits Rectangle {
    width: 100%;
    height: 100%;
    in-out property <string> title: "添加别名";
    in-out property <string> value: "";
    callback value-changed(string);
    callback committed(string);
    callback cancelled();
    // 与主窗共用同一套主题色
    in-out property <color> th-menu: #1b212bf7;
    in-out property <color> th-input: #0d1117;
    in-out property <color> th-text: #ffffff;
    in-out property <color> th-sub: #8b96ae;
    in-out property <color> th-accent: #63d8cd;
    in-out property <color> th-accent2: #6fd7cd;
    in-out property <color> th-accent-dark: #2f8f8a;
    in-out property <color> th-accent-line: #63d8cd55;
    in-out property <color> th-accent-border: #6fd7cd66;
    in-out property <color> th-on-accent: #0b1017;

    Rectangle {
        width: 100%; height: 100%;
        background: #05070bcc;
        // 吃掉点击，避免穿透到下面的结果行
        TouchArea { }
    }
    Rectangle {
        x: 60px; y: 96px;
        width: parent.width - 120px; height: 172px;
        border-radius: 14px;
        background: root.th-menu;
        border-width: 1px;
        border-color: #ffffff20;
        drop-shadow-blur: 28px;
        drop-shadow-color: #00000088;
        drop-shadow-offset-y: 8px;

        Text {
            x: 20px; y: 16px; width: parent.width - 40px; height: 24px;
            text: root.title;
            color: root.th-text;
            font-size: 15px; font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            x: 20px; y: 40px; width: parent.width - 40px; height: 18px;
            text: "输入一个更好记的名字，回车确认（Esc 取消）";
            color: root.th-sub; font-size: 11.5px;
            vertical-alignment: center;
        }
        Rectangle {
            x: 20px; y: 66px; width: parent.width - 40px; height: 38px;
            border-radius: 9px;
            background: root.th-input;
            border-width: 1px;
            border-color: root.th-accent-line;
            field := TextInput {
                x: 10px; y: 0; width: parent.width - 20px; height: 100%;
                vertical-alignment: center;
                text <=> root.value;
                color: root.th-text;
                font-size: 14px;
                selection-foreground-color: root.th-on-accent;
                selection-background-color: root.th-accent;
                edited => { root.value-changed(root.value); }
                accepted => { root.committed(root.value); }
                key-pressed(e) => {
                    if (e.text == Key.Escape) { root.cancelled(); return accept; }
                    return reject;
                }
            }
        }
        // 取消 / 确认
        Rectangle {
            x: parent.width - 178px; y: 118px; width: 72px; height: 32px;
            border-radius: 9px;
            background: cancel-ta.has-hover ? #ffffff16 : #ffffff0d;
            border-width: 1px; border-color: #ffffff18;
            animate background { duration: 90ms; }
            Text {
                width: 100%; height: 100%;
                text: "取消"; color: #b9c3d6; font-size: 12px;
                horizontal-alignment: center; vertical-alignment: center;
            }
            cancel-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.cancelled(); }
            }
        }
        Rectangle {
            x: parent.width - 98px; y: 118px; width: 78px; height: 32px;
            border-radius: 9px;
            background: ok-ta.has-hover ? root.th-accent : root.th-accent-dark;
            border-width: 1px; border-color: root.th-accent-border;
            animate background { duration: 90ms; }
            Text {
                width: 100%; height: 100%;
                text: "确认"; color: root.th-text; font-size: 12px; font-weight: 600;
                horizontal-alignment: center; vertical-alignment: center;
            }
            ok-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.committed(root.value); }
            }
        }
    }
    init => { field.focus(); }
}

// 键帽：统一底部提示 / 空态标签的按键样式
component Keycap inherits Rectangle {
    in property <string> label;
    height: 20px;
    width: max(22px, cap-text.preferred-width + 14px);
    border-radius: 6px;
    background: #ffffff0a;
    border-width: 1px;
    border-color: #ffffff16;
    cap-text := Text {
        width: 100%; height: 100%;
        text: root.label;
        color: #aeb8c9;
        font-size: 10.5px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component MainWindow inherits Window {
    width: 744px;
    height: root.window-height;
    title: "flowtary-slint";   // 主进程靠这个标题找到渲染器界面窗口（判断「启动器开着没」）
    no-frame: true;
    background: transparent;
    default-font-family: "Segoe UI";

    in-out property <[ResultItem]> items: [];
    in-out property <int> selected: 0;
    in-out property <string> query: "";
    in-out property <bool> empty: false;          // 无结果时显示 welcome 面板
    in-out property <length> window-height: 300px; // C++ 按结果行数动态设置
    // Slint 自绘右键菜单（不再使用原生 GDI 菜单）
    in-out property <[MenuItem]> menu-items: [];
    in-out property <bool> menu-open: false;
    in-out property <int> menu-selected: 0;
    in-out property <length> menu-x: 392px;
    in-out property <length> menu-y: 70px;
    in-out property <length> menu-width: 288px;
    // 添加别名输入覆盖层（替代原生对话框，与启动器同一套视觉）
    in-out property <bool> alias-open: false;
    in-out property <string> alias-text: "";
    in-out property <string> alias-title: "添加别名";
    // 主题调色板（主进程按 kThemes + 微调下发）
    in-out property <color> th-panel-top: #12172226;
    in-out property <color> th-panel-bottom: #080b111f;
    in-out property <color> th-glow: #4fd0c610;
    in-out property <color> th-menu: #191e27f5;
    in-out property <color> th-input: #0d1117;
    in-out property <color> th-text: #ffffff;
    in-out property <color> th-sub: #8b96ae;
    in-out property <color> th-accent: #63d8cd;
    in-out property <color> th-accent2: #6fd7cd;
    in-out property <color> th-accent-dark: #2f8f8a;
    in-out property <color> th-accent-soft: #63d8cd1f;
    in-out property <color> th-accent-line: #63d8cd55;
    in-out property <color> th-accent-border: #6fd7cd66;
    in-out property <color> th-sel-a: #2f8f8a40;
    in-out property <color> th-sel-b: #1f5f5e22;
    in-out property <color> th-on-accent: #0b1017;
    in-out property <length> th-radius: 16px;

    // 唤起动效：内容淡入 + 轻微上浮（由 C++ 在 show 后触发）
    // 默认 true：渲染器启动时先建窗口，避免首帧出现空面板
    in-out property <bool> revealed: true;

    // → C++ 回调
    callback query-changed(string);
    callback item-activated(int);       // 回车激活（携带 Ctrl/Shift 语义，由 C++ 侧读键态）
    callback item-clicked(int);         // 鼠标点击激活（始终按普通方式执行）
    callback escape-pressed();
    callback clear-query();
    callback move-selection(int);       // -1 / +1
    callback focus-input();              // 请求把焦点给搜索框
    callback menu-picked(int);           // 选中右键菜单第 idx 项
    callback menu-dismissed();           // 点击菜单外/按 Esc 关闭
    callback alias-committed(string);
    callback alias-cancelled();

    // —— 面板底板：外投影 + 主题渐变 + 顶部高光 ——
    // 窗口四周留 32px 透明边距容纳完整投影（与 C++ 的 kUiMargin 对应）
    Rectangle {
        x: 32px; y: root.revealed ? 32px : 40px;
        width: parent.width - 64px; height: parent.height - 64px;
        opacity: root.revealed ? 1 : 0;
        animate opacity { duration: 150ms; easing: ease-out; }
        animate y { duration: 180ms; easing: ease-out; }
        border-radius: root.th-radius;
        background: transparent;
        border-width: 1px;
        border-color: #ffffff16;

        // 柔和投影：软件渲染不支持高斯模糊，用多层低透明度圆角描边叠出渐变
        for i in 8: Rectangle {
            x: -3px - i * 2.5px;
            y: -3px - i * 2.5px + 5px;
            width: parent.width + 6px + i * 5px;
            height: parent.height + 6px + i * 5px;
            border-radius: root.th-radius + 3px + i * 2.5px;
            background: transparent;
            border-width: 4px;
            border-color: i == 0 ? #00000012 : i == 1 ? #00000010 : i == 2 ? #0000000d
                        : i == 3 ? #0000000a : i == 4 ? #00000008 : i == 5 ? #00000006
                        : i == 6 ? #00000004 : #00000002;
        }

        // 玻璃底色：单独一层并留一点透，DWM 模糊从背后透上来
        Rectangle {
            x: 0; y: 0; width: 100%; height: 100%;
            border-radius: root.th-radius;
            background: @linear-gradient(180deg, root.th-panel-top 0%, root.th-panel-bottom 100%);
            opacity: 0.88;
        }

        // 顶部极淡强调色氛围光，避免整块玻璃发灰
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: 150px;
            border-radius: root.th-radius - 1px;
            background: @linear-gradient(180deg, root.th-glow 0%, transparent 100%);
        }
        // 玻璃斜向反光：左上亮、右下暗，制造薄玻璃的折射层次
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            border-radius: root.th-radius - 1px;
            background: @linear-gradient(122deg,
                #ffffff24 0%,
                #ffffff0b 22%,
                transparent 46%,
                transparent 68%,
                #00000018 100%);
        }
        // 顶部镜面高光（避开 1px 边框，两端淡出）
        Rectangle {
            x: 20px; y: 2px; width: parent.width - 40px; height: 1px;
            background: @linear-gradient(90deg,
                transparent 0%, #ffffff70 24%, #ffffff70 76%, transparent 100%);
        }
        // 底部暗边，收住玻璃下缘
        Rectangle {
            x: 18px; y: parent.height - 3px; width: parent.width - 36px; height: 1px;
            background: @linear-gradient(90deg,
                transparent 0%, #00000055 24%, #00000055 76%, transparent 100%);
        }

    // —— 搜索区 ——
    // 放大镜：圆环 + 手柄（描边路径，不填充）
    Path {
        x: 21px; y: 22px; width: 20px; height: 20px;
        fill: transparent;
        stroke: root.query != "" ? root.th-accent : root.th-sub;
        stroke-width: 1.8px;
        commands: "M 8 0 A 8 8 0 1 0 8 16 A 8 8 0 1 0 8 0 M 14 14 L 19 19";
    }
    Text {
        x: 52px; y: 0; width: parent.width - 52px - 78px; height: 64px;
        vertical-alignment: center;
        text: "搜索程序、文件或网页…";
        color: root.th-sub;
        font-size: 16px;
        visible: root.query == "";
    }
    input := TextInput {
        x: 52px; y: 0; width: parent.width - 52px - 78px; height: 64px;
        vertical-alignment: center;
        text <=> root.query;
        color: root.th-text;
        font-size: 16px;
        selection-foreground-color: root.th-on-accent;
        selection-background-color: root.th-accent;
        edited => { root.query-changed(root.query); }
        accepted => {
            if (!root.empty && root.selected >= 0 && root.selected < root.items.length) {
                root.item-activated(root.selected);
            }
        }
        key-pressed(e) => {
            if (e.text == Key.UpArrow) {
                root.move-selection(-1); return accept;
            } else if (e.text == Key.DownArrow) {
                root.move-selection(1); return accept;
            } else if (e.text == Key.Escape) {
                root.escape-pressed(); return accept;
            }
            return reject;
        }
    }
    // 右侧 Esc 键帽
    Rectangle {
        x: parent.width - 58px; y: 21px; width: 42px; height: 22px;
        border-radius: 7px;
        background: #ffffff0a;
        border-width: 1px;
        border-color: #ffffff16;
        Text {
            width: 100%; height: 100%;
            text: "Esc";
            color: root.th-sub;
            font-size: 10.5px; font-weight: 600;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    // 有输入时的清空按钮
    if root.query != "": Rectangle {
        x: parent.width - 96px; y: 20px; width: 24px; height: 24px;
        border-radius: 12px;
        background: clear-ta.has-hover ? #ffffff18 : #ffffff0a;
        animate background { duration: 90ms; }
        Text {
            width: 100%; height: 100%;
            text: "×";
            color: root.th-sub;
            font-size: 15px; font-weight: 600;
            horizontal-alignment: center; vertical-alignment: center;
        }
        clear-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clear-query(); }
        }
    }
    // 搜索区 / 结果区的发丝分隔线（两端淡出）
    Rectangle {
        x: 16px; y: 64px; width: parent.width - 32px; height: 1px;
        background: @linear-gradient(90deg, transparent 0%, #ffffff1c 18%, #ffffff1c 82%, transparent 100%);
    }

    // —— 结果列表 ——
    VerticalLayout {
        x: 8px; y: 70px; width: parent.width - 16px;
        spacing: 2px;

        for item[idx] in items: Rectangle {
            height: item.kind == 4 ? 34px : 54px;
            border-radius: 12px;
            background: transparent;

            ta := TouchArea {
                x: 0; y: 0; width: 100%; height: 100%;
                mouse-cursor: pointer;
                moved => { root.selected = idx; }
                clicked => { root.item-clicked(idx); }
            }

            // 悬停底色（选中行不叠）
            Rectangle {
                x: 0; y: 0; width: 100%; height: 100%;
                border-radius: 12px;
                background: #ffffff10;
                opacity: ta.has-hover && idx != root.selected ? 1 : 0;
                animate opacity { duration: 100ms; easing: ease-out; }
            }
            // 选中底色：青色渐变 + 细描边，淡入淡出
            Rectangle {
                x: 0; y: 0; width: 100%; height: 100%;
                border-radius: 12px;
                background: @linear-gradient(90deg, root.th-sel-a 0%, root.th-sel-b 100%);
                border-width: 1px;
                border-color: root.th-accent-line;
                opacity: idx == root.selected ? 1 : 0;
                animate opacity { duration: 120ms; easing: ease-out; }
            }
            // 选中行左侧强调条
            Rectangle {
                x: 0; y: 12px; width: 3px; height: parent.height - 24px;
                border-radius: 2px;
                background: root.th-accent;
                opacity: idx == root.selected ? 1 : 0;
                animate opacity { duration: 120ms; easing: ease-out; }
            }

            // 图标：有真实 image 用之，否则回退文字徽标；提示行（kind=4）不画图标
            if item.kind != 4: Rectangle {
                x: 14px; y: (parent.height - 38px) / 2;
                width: 38px; height: 38px;
                border-radius: 12px;
                background: item.icon-bg;
                border-width: 1px;
                border-color: idx == root.selected ? #ffffff33 : #ffffff1a;
                Text {
                    width: 100%; height: 100%;
                    text: item.glyph;
                    color: root.th-text;
                    font-size: 10px; font-weight: 700;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                Image {
                    x: 3px; y: 3px; width: 32px; height: 32px;
                    source: item.icon;
                    image-fit: contain;
                }
            }

            // 普通结果：标题 + 副标题
            if item.kind != 4: Text {
                x: 64px; y: 8px;
                width: parent.width - 64px - 58px - (item.usage-tier > 0 ? 42px : 0px);
                height: 20px;
                text: item.title;
                color: idx == root.selected ? root.th-text : item.usage-tier > 0 ? root.th-accent2 : root.th-text;
                font-size: 14.5px;
                font-weight: idx == root.selected || item.usage-tier > 0 ? 600 : 500;
                vertical-alignment: center;
                overflow: elide;
                animate color { duration: 120ms; }
            }
            if item.kind != 4: Text {
                x: 64px; y: 27px;
                width: parent.width - 64px - 58px - (item.usage-tier > 0 ? 42px : 0px);
                height: 16px;
                text: item.sub;
                color: idx == root.selected ? #e8eef8 : root.th-sub;
                font-size: 11.5px;
                vertical-alignment: center;
                overflow: elide;
                animate color { duration: 120ms; }
            }

            // 使用次数徽章「×N」：常用/高频/重度，用法与 GDI 版分档一致
            if item.usage-tier > 0 && item.kind != 4: Rectangle {
                x: item.hotkey != "" ? parent.width - 82px : parent.width - 50px;
                y: (parent.height - 20px) / 2;
                width: 34px; height: 20px;
                border-radius: 7px;
                background: idx == root.selected ? #ffffff24
                          : item.usage-tier >= 3 ? root.th-accent-soft : #ffffff0a;
                border-width: 1px;
                border-color: idx == root.selected ? #ffffff30
                            : item.usage-tier >= 3 ? root.th-accent-line : #ffffff12;
                Text {
                    width: 100%; height: 100%;
                    text: item.usage-badge;
                    color: idx == root.selected ? root.th-accent2
                         : item.usage-tier >= 3 ? root.th-accent2 : root.th-sub;
                    font-size: 10px; font-weight: 600;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
            // 提示行：单行说明，左边距对齐图标之外
            if item.kind == 4: Text {
                x: 18px; width: parent.width - 52px; height: 100%;
                text: item.title;
                color: root.th-sub;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }

            // 快捷键徽章
            if item.hotkey != "" && item.kind != 4: Rectangle {
                x: parent.width - 42px; y: (parent.height - 20px) / 2;
                width: 26px; height: 20px;
                border-radius: 7px;
                background: idx == root.selected ? #ffffff1f : #ffffff0a;
                border-width: 1px;
                border-color: idx == root.selected ? #ffffff30 : #ffffff12;
                Text {
                    width: 100%; height: 100%;
                    text: item.hotkey;
                    color: idx == root.selected ? root.th-accent2 : root.th-sub;
                    font-size: 11px; font-weight: 600;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }

    // —— 底部快捷键提示（有结果且菜单未打开时显示）——
    if !root.empty && !root.menu-open: Rectangle {
        x: 0; y: parent.height - 34px; width: 100%; height: 34px;
        Rectangle {
            x: 16px; y: 0; width: parent.width - 32px; height: 1px;
            background: @linear-gradient(90deg, transparent 0%, #ffffff12 18%, #ffffff12 82%, transparent 100%);
        }
        HorizontalLayout {
            x: 18px; y: 7px; width: parent.width - 36px; height: 20px;
            spacing: 6px;
            alignment: start;
            Keycap { label: "↑↓"; }
            Text {
                text: "选择"; color: root.th-sub; font-size: 11px;
                vertical-alignment: center;
            }
            Keycap { label: "↵"; }
            Text {
                text: "打开"; color: root.th-sub; font-size: 11px;
                vertical-alignment: center;
            }
            Keycap { label: "Esc"; }
            Text {
                text: "隐藏"; color: root.th-sub; font-size: 11px;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            x: parent.width - 190px; y: 7px; width: 174px; height: 20px;
            spacing: 6px;
            alignment: end;
            Keycap { label: "Alt + 数字"; }
            Text {
                text: "快速打开"; color: root.th-sub; font-size: 11px;
                vertical-alignment: center;
            }
        }
    }

    // —— 空态欢迎面板（整体垂直居中）——
    if empty && root.query == "": Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        Rectangle {
            x: (parent.width - 56px) / 2; y: (parent.height - 160px) / 2;
            width: 56px; height: 56px;
            border-radius: 17px;
            background: @linear-gradient(135deg, root.th-accent 0%, root.th-accent-dark 100%);
            border-width: 1px;
            border-color: #ffffff33;
            drop-shadow-blur: 18px;
            drop-shadow-color: root.th-accent-dark;
            Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: 26px;
                border-radius: 16px;
                background: @linear-gradient(180deg, #ffffff2e 0%, transparent 100%);
            }
            Text {
                width: 100%; height: 100%;
                text: "F";
                color: root.th-text;
                font-size: 28px; font-weight: 800;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        Text {
            x: 0; y: (parent.height - 160px) / 2 + 72px; width: 100%; height: 30px;
            text: "Flowtary";
            color: root.th-text;
            font-size: 23px; font-weight: 600;
            letter-spacing: 0.4px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            x: 0; y: (parent.height - 160px) / 2 + 104px; width: 100%; height: 20px;
            text: "搜索程序、文件与网页";
            color: root.th-sub;
            font-size: 12.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        HorizontalLayout {
            x: 0; y: (parent.height - 160px) / 2 + 136px; width: 100%; height: 24px;
            alignment: center;
            spacing: 8px;
            Rectangle {
                width: 96px; height: 24px;
                border-radius: 7px;
                background: #ffffff08;
                border-width: 1px; border-color: #ffffff12;
                Text {
                    width: 100%; height: 100%;
                    text: "输入即搜索";
                    color: root.th-sub; font-size: 10.5px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
            Rectangle {
                width: 104px; height: 24px;
                border-radius: 7px;
                background: #ffffff08;
                border-width: 1px; border-color: #ffffff12;
                Text {
                    width: 100%; height: 100%;
                    text: "Alt+Space 唤起";
                    color: root.th-sub; font-size: 10.5px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
            Rectangle {
                width: 78px; height: 24px;
                border-radius: 7px;
                background: #ffffff08;
                border-width: 1px; border-color: #ffffff12;
                Text {
                    width: 100%; height: 100%;
                    text: "Esc 隐藏";
                    color: root.th-sub; font-size: 10.5px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }

    // —— 无结果（整体垂直居中） ——
    if empty && root.query != "": Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        Rectangle {
            x: (parent.width - 52px) / 2; y: (parent.height - 112px) / 2;
            width: 52px; height: 52px;
            border-radius: 16px;
            background: #ffffff08;
            border-width: 1px;
            border-color: #ffffff14;
            Path {
                x: (parent.width - 20px) / 2; y: (parent.height - 20px) / 2;
                width: 20px; height: 20px;
                fill: transparent;
                stroke: root.th-sub;
                stroke-width: 2px;
                commands: "M 8 0 A 8 8 0 1 0 8 16 A 8 8 0 1 0 8 0 M 14 14 L 19 19";
            }
        }
        Text {
            x: 60px; y: (parent.height - 112px) / 2 + 64px; width: parent.width - 120px; height: 26px;
            text: "没有找到 “" + root.query + "”";
            color: root.th-text;
            font-size: 15.5px; font-weight: 500;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            x: 0; y: (parent.height - 112px) / 2 + 92px; width: 100%; height: 20px;
            text: "换个关键词，或等索引扫描完成再试";
            color: root.th-sub;
            font-size: 12px;
            horizontal-alignment: center;
        }
    }

    // —— Slint 自绘右键菜单 ——
    // 点击菜单外关闭（透明层只负责吃点击）
    if root.menu-open: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        TouchArea {
            clicked => { root.menu-dismissed(); }
        }
    }
    if root.menu-open: Rectangle {
        x: root.menu-x; y: root.menu-y;
        width: root.menu-width;
        height: root.menu-items.length * 32px + 10px;
        border-radius: 12px;
        background: root.th-menu;
        border-width: 1px;
        border-color: #ffffff22;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 4px;

        VerticalLayout {
            x: 5px; y: 5px; width: parent.width - 10px;
            for item[idx] in root.menu-items: Rectangle {
                height: 32px;
                border-radius: 8px;
                background: idx == root.menu-selected ? #ffffff14 : transparent;
                animate background { duration: 90ms; }
                Text {
                    x: 10px; y: 0; width: parent.width - 20px; height: 100%;
                    text: item.label;
                    color: item.is-default ? root.th-accent2 : root.th-text;
                    font-size: 12.5px;
                    font-weight: item.is-default ? 600 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    moved => { root.menu-selected = idx; }
                    clicked => { root.menu-picked(idx); }
                }
            }
        }
    }

    // —— 添加别名：窗口内输入覆盖层（独立组件，方便创建时聚焦输入框） ——
    if root.alias-open: AliasCard {
        title: root.alias-title;
        value: root.alias-text;
        th-menu: root.th-menu;
        th-input: root.th-input;
        th-text: root.th-text;
        th-sub: root.th-sub;
        th-accent: root.th-accent;
        th-accent2: root.th-accent2;
        th-accent-dark: root.th-accent-dark;
        th-accent-line: root.th-accent-line;
        th-accent-border: root.th-accent-border;
        th-on-accent: root.th-on-accent;
        value-changed(v) => { root.alias-text = v; }
        committed(t) => { root.alias-committed(t); }
        cancelled => { root.alias-cancelled(); }
    }
    }  // panel

    focus-input => { input.focus(); }
}


// —— 顶部 toast：独立无边框窗口，点击穿透、自动消失 ——
export component ToastWindow inherits Window {
    width: 360px;
    height: 56px;
    no-frame: true;
    background: transparent;
    default-font-family: "Segoe UI";
    in-out property <string> message: "";
    in-out property <color> th-menu: #1b212bf2;
    in-out property <color> th-text: #f2f6fc;

    Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        border-radius: 14px;
        background: root.th-menu;
        border-width: 1px;
        border-color: #ffffff1f;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000055;
        Text {
            x: 18px; y: 0; width: parent.width - 36px; height: 100%;
            text: root.message;
            color: root.th-text;
            font-size: 13px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
