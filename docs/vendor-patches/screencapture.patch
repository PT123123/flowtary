+    constexpr UINT flags = SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE | SWP_SHOWWINDOW;
+    SetWindowPos(hwnd, HWND_TOPMOST, 0, 0, 0, 0, flags);
