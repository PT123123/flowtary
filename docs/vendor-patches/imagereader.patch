+
+void WindowMain::showContextMenu(POINT pt)
+{
+    auto doc = imgViewer ? imgViewer->getDoc() : nullptr;
+    const bool hasText = doc && !doc->empty();
+    const bool hasSel = doc && doc->hasSelection();
+
+    HMENU menu = CreatePopupMenu();
+    if (!menu) return;
+    AppendMenuW(menu, MF_STRING | (hasSel ? 0 : MF_GRAYED),
+        kCmdCopySelection, L"复制选中文本\tCtrl+C");
+    AppendMenuW(menu, MF_STRING | (hasText ? 0 : MF_GRAYED),
+        kCmdCopyAll, L"复制全部文本");
+    AppendMenuW(menu, MF_STRING | (hasText ? 0 : MF_GRAYED),
+        kCmdSelectAll, L"全选\tCtrl+A");
+    AppendMenuW(menu, MF_SEPARATOR, 0, nullptr);
+    AppendMenuW(menu, MF_STRING | (hasText ? 0 : MF_GRAYED),
+        kCmdEditText, L"编辑文本...\tCtrl+E");
+
+    POINT screenPt = pt;   // onDown receives client coordinates
+    ClientToScreen(hwnd, &screenPt);
+    SetForegroundWindow(hwnd);
+    // TPM_RETURNCMD returns the chosen id synchronously, so no WM_COMMAND has
+    // to be routed through Ling's window procedure.
+    const int cmd = (int)TrackPopupMenuEx(menu,
+        TPM_RETURNCMD | TPM_NONOTIFY | TPM_RIGHTBUTTON | TPM_LEFTALIGN | TPM_TOPALIGN,
+        screenPt.x, screenPt.y, hwnd, nullptr);
+    DestroyMenu(menu);
+
+    switch (cmd) {
+    case kCmdCopySelection:
+        if (hasSel) Ling::Util::setTextToClipboard(doc->getSelectedText());
+        break;
+    case kCmdCopyAll:
+        if (hasText) Ling::Util::setTextToClipboard(doc->getAllText());
+        break;
+    case kCmdSelectAll:
+        if (hasText && doc->selectAll()) doc->notifyChanged();
+        break;
+    case kCmdEditText:
+        editText();
+        break;
+    default:
+        break;
+    }
+}
+
+void WindowMain::editText()
+{
+    auto doc = imgViewer ? imgViewer->getDoc() : nullptr;
+    if (!doc || doc->empty()) return;
+    std::wstring text = doc->getAllText();
+    if (!showTextEditDialog(hwnd, text)) return;
+    doc->replaceText(text);
+    textBox->loadText(doc);   // rebuild text layouts for the edited content
+    doc->notifyChanged();     // repaint the selection surfaces on both sides
+    refresh();                // repaint the image-side overlay
+}
