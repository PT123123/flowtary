diff --git a/ImageReader/OcrTextEdit.cpp b/ImageReader/OcrTextEdit.cpp
new file mode 100644
index 0000000..a67fa63
--- /dev/null
+++ b/ImageReader/OcrTextEdit.cpp
@@ -0,0 +1,195 @@
+#include "pch.h"
+#include "OcrTextEdit.h"
+#include <algorithm>
+
+// A small self-contained Win32 modal editor. Kept out of Ling's node tree on
+// purpose: a native EDIT control gives us caret, IME, undo and selection for
+// free, which the read-only OCR text panel does not provide.
+namespace {
+    constexpr int kIdEdit = 101;
+    constexpr int kIdOk = 102;
+    constexpr int kIdCancel = 103;
+    constexpr int kIdCopyAll = 104;
+    constexpr const wchar_t* kClassName = L"FlowtaryOcrTextEdit";
+
+    struct EditState {
+        HWND hwnd{ nullptr };
+        HWND parent{ nullptr };
+        HWND edit{ nullptr };
+        HFONT font{ nullptr };
+        std::wstring initial;
+        std::wstring result;
+        bool confirmed{ false };
+        bool done{ false };
+    };
+    EditState g;
+
+    std::wstring getEditContent(HWND edit)
+    {
+        if (!edit || !IsWindow(edit)) return {};
+        int len = GetWindowTextLengthW(edit);
+        if (len <= 0) return {};
+        std::wstring out((size_t)len + 1, L'\0');
+        int n = GetWindowTextW(edit, out.data(), len + 1);
+        out.resize((size_t)(std::max)(0, n));
+        return out;
+    }
+
+    HWND makeButton(HWND parent, const wchar_t* label, int id)
+    {
+        return CreateWindowExW(0, L"BUTTON", label,
+            WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_PUSHBUTTON,
+            0, 0, 0, 0, parent,
+            reinterpret_cast<HMENU>(static_cast<INT_PTR>(id)),
+            GetModuleHandleW(nullptr), nullptr);
+    }
+
+    LRESULT CALLBACK editProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam)
+    {
+        switch (msg) {
+        case WM_CREATE: {
+            g.font = CreateFontW(-16, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
+                DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
+                DEFAULT_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Microsoft YaHei UI");
+            g.edit = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", nullptr,
+                WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP |
+                ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | ES_AUTOHSCROLL,
+                0, 0, 0, 0, hwnd,
+                reinterpret_cast<HMENU>(static_cast<INT_PTR>(kIdEdit)),
+                GetModuleHandleW(nullptr), nullptr);
+            if (g.font) SendMessageW(g.edit, WM_SETFONT, (WPARAM)g.font, TRUE);
+            SetWindowTextW(g.edit, g.initial.c_str());
+            return 0;
+        }
+        case WM_SIZE: {
+            const int w = LOWORD(lParam), h = HIWORD(lParam);
+            constexpr int pad = 12, btnW = 96, btnH = 28, gap = 8;
+            int editH = h - btnH - pad * 3;
+            if (editH < 40) editH = 40;
+            if (g.edit) MoveWindow(g.edit, pad, pad, (std::max)(40, w - pad * 2), editH, TRUE);
+            int bx = w - pad - btnW;
+            const int by = h - btnH - pad;
+            HWND ok = GetDlgItem(hwnd, kIdOk);
+            HWND cancel = GetDlgItem(hwnd, kIdCancel);
+            HWND copy = GetDlgItem(hwnd, kIdCopyAll);
+            if (ok) MoveWindow(ok, bx, by, btnW, btnH, TRUE);
+            bx -= btnW + gap;
+            if (cancel) MoveWindow(cancel, bx, by, btnW, btnH, TRUE);
+            bx -= btnW + gap;
+            if (copy) MoveWindow(copy, bx, by, btnW, btnH, TRUE);
+            return 0;
+        }
+        case WM_COMMAND: {
+            const int id = LOWORD(wParam);
+            if (id == kIdOk) {
+                g.result = getEditContent(g.edit);
+                g.confirmed = true;
+                g.done = true;
+            }
+            else if (id == kIdCancel) {
+                g.done = true;
+            }
+            else if (id == kIdCopyAll) {
+                auto cur = getEditContent(g.edit);
+                if (!cur.empty()) Ling::Util::setTextToClipboard(cur);
+            }
+            return 0;
+        }
+        case WM_CLOSE:
+            g.done = true;
+            return 0;
+        case WM_DESTROY:
+            if (g.font) { DeleteObject(g.font); g.font = nullptr; }
+            g.hwnd = nullptr;
+            return 0;
+        }
+        return DefWindowProcW(hwnd, msg, wParam, lParam);
+    }
+}
+
+bool showTextEditDialog(HWND parent, std::wstring& text)
+{
+    static bool registered = false;
+    if (!registered) {
+        WNDCLASSEXW wc{ sizeof(WNDCLASSEXW) };
+        wc.style = CS_HREDRAW | CS_VREDRAW;
+        wc.lpfnWndProc = editProc;
+        wc.hInstance = GetModuleHandleW(nullptr);
+        wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
+        wc.hbrBackground = (HBRUSH)(COLOR_3DFACE + 1);
+        wc.lpszClassName = kClassName;
+        if (!RegisterClassExW(&wc)) return false;
+        registered = true;
+    }
+
+    g = EditState{};
+    g.initial = text;
+    g.parent = parent;
+
+    RECT rc{};
+    if (parent && IsWindow(parent)) GetWindowRect(parent, &rc);
+    else { rc = RECT{ 0, 0, GetSystemMetrics(SM_CXSCREEN), GetSystemMetrics(SM_CYSCREEN) }; }
+    constexpr int ww = 720, wh = 520;
+    int wx = rc.left + ((rc.right - rc.left) - ww) / 2;
+    int wy = rc.top + ((rc.bottom - rc.top) - wh) / 2;
+    if (wx < 0) wx = 0;
+    if (wy < 0) wy = 0;
+
+    g.hwnd = CreateWindowExW(WS_EX_DLGMODALFRAME | WS_EX_CONTROLPARENT,
+        kClassName, L"编辑识别文本",
+        WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_SIZEBOX | WS_VISIBLE,
+        wx, wy, ww, wh, parent, nullptr, GetModuleHandleW(nullptr), nullptr);
+    if (!g.hwnd) return false;
+
+    // Buttons must exist before WM_CREATE returns (WM_SETFONT in WM_CREATE
+    // looks them up). Create them right after the top-level window is up.
+    makeButton(g.hwnd, L"复制全部", kIdCopyAll);
+    makeButton(g.hwnd, L"取消", kIdCancel);
+    makeButton(g.hwnd, L"确定", kIdOk);
+    if (g.font) {
+        for (int id : { kIdCopyAll, kIdCancel, kIdOk }) {
+            SendMessageW(GetDlgItem(g.hwnd, id), WM_SETFONT, (WPARAM)g.font, TRUE);
+        }
+    }
+    SendMessageW(g.hwnd, WM_SIZE, 0, MAKELPARAM(ww, wh));
+    SetFocus(g.edit);
+
+    const bool parentEnabled = parent && IsWindow(parent) && IsWindowEnabled(parent);
+    if (parentEnabled) EnableWindow(parent, FALSE);
+
+    // Modal loop. PeekMessage + WaitMessage avoids blocking forever after the
+    // window is destroyed (GetMessage would wait for a message that never comes).
+    MSG msg{};
+    while (!g.done) {
+        if (PeekMessageW(&msg, nullptr, 0, 0, PM_REMOVE)) {
+            if (msg.message == WM_QUIT) {
+                PostQuitMessage((int)msg.wParam);  // pass through to the outer Ling loop
+                break;
+            }
+            if (msg.message == WM_KEYDOWN && msg.wParam == VK_ESCAPE) break;
+            // Ctrl+A in a multi-line EDIT is not handled by the control itself.
+            if (msg.message == WM_KEYDOWN && msg.wParam == 'A'
+                && (GetKeyState(VK_CONTROL) & 0x8000) != 0 && g.edit) {
+                SendMessageW(g.edit, EM_SETSEL, 0, -1);
+                continue;
+            }
+            // Only Tab goes through the dialog manager. Passing Enter to it
+            // would close the window instead of inserting a new line.
+            if (g.hwnd && msg.message == WM_KEYDOWN && msg.wParam == VK_TAB
+                && IsDialogMessageW(g.hwnd, &msg)) continue;
+            TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+        else {
+            WaitMessage();
+        }
+    }
+
+    if (g.hwnd && IsWindow(g.hwnd)) DestroyWindow(g.hwnd);
+    if (parentEnabled) {
+        EnableWindow(parent, TRUE);
+        SetForegroundWindow(parent);
+    }
+    if (g.confirmed) text = std::move(g.result);
+    return g.confirmed;
+}
