+
+// 编辑后的文本可能改变行数与每行长度：按行沿用原有字符框，新增字符按原行
+// AABB 均分，重建几何后图像侧的选区高亮仍然可用。
+static ComPtr<ID2D1PathGeometry> makeQuadGeometry(const Quad& q)
+{
+	auto d2d = Ling::D2D::get();
+	ComPtr<ID2D1PathGeometry> path;
+	if (FAILED(d2d->d2dFactory->CreatePathGeometry(path.GetAddressOf()))) return nullptr;
+	ComPtr<ID2D1GeometrySink> sink;
+	if (FAILED(path->Open(sink.GetAddressOf()))) return nullptr;
+	sink->BeginFigure(q.p[0], D2D1_FIGURE_BEGIN_FILLED);
+	sink->AddLine(q.p[1]);
+	sink->AddLine(q.p[2]);
+	sink->AddLine(q.p[3]);
+	sink->EndFigure(D2D1_FIGURE_END_CLOSED);
+	if (FAILED(sink->Close())) return nullptr;
+	return path;
+}
+
+std::wstring OcrDoc::getAllText() const
+{
+	std::wstring out;
+	for (const auto& line : lines) {
+		if (!out.empty()) out += L"\r\n";
+		out += line.text;
+	}
+	return out;
+}
+
+void OcrDoc::replaceText(const std::wstring& text)
+{
+	std::vector<std::wstring> newTexts;
+	size_t start = 0;
+	for (size_t i = 0; i <= text.size(); ++i) {
+		if (i == text.size() || text[i] == L'\n' || text[i] == L'\r') {
+			newTexts.push_back(text.substr(start, i - start));
+			if (i < text.size() && text[i] == L'\r' && i + 1 < text.size() && text[i + 1] == L'\n') ++i;
+			start = i + 1;
+		}
+	}
+	if (newTexts.empty()) newTexts.emplace_back();
+
+	std::vector<OcrLine> rebuilt;
+	rebuilt.reserve(newTexts.size());
+	for (size_t li = 0; li < newTexts.size(); ++li) {
+		OcrLine out;
+		out.text = std::move(newTexts[li]);
+		out.charQuads.assign(out.text.size(), Quad{});
+		out.charGeoms.assign(out.text.size(), nullptr);
+
+		const OcrLine* old = li < lines.size() ? &lines[li]
+			: (lines.empty() ? nullptr : &lines.back());
+		const size_t oldN = old ? old->charQuads.size() : 0;
+		const bool hasBox = old && old->hasGeom
+			&& old->boxRight > old->boxLeft && old->boxBottom > old->boxTop;
+		const float l = old ? old->boxLeft : 0.f, t = old ? old->boxTop : 0.f;
+		const float r = old ? old->boxRight : 0.f, b = old ? old->boxBottom : 0.f;
+		const float span = hasBox ? (r - l) / (float)(std::max)(oldN, (size_t)1) : 0.f;
+
+		for (size_t ch = 0; ch < out.text.size(); ++ch) {
+			if (std::iswspace(static_cast<wint_t>(out.text[ch]))) continue;
+			Quad q;
+			if (old && ch < oldN && old->charQuads[ch].valid) {
+				q = old->charQuads[ch];
+			}
+			else if (hasBox) {
+				const float x0 = l + span * (float)ch;
+				const float x1 = l + span * ((float)ch + 1.f);
+				q.p[0] = { x0, t }; q.p[1] = { x1, t };
+				q.p[2] = { x1, b }; q.p[3] = { x0, b };
+				q.valid = x1 > x0 && b > t;
+			}
+			if (!q.valid) continue;
+			auto geom = makeQuadGeometry(q);
+			if (!geom) continue;
+			out.charQuads[ch] = q;
+			out.charGeoms[ch] = geom;
+			if (!out.hasGeom) {
+				out.boxLeft = q.left(); out.boxTop = q.top();
+				out.boxRight = q.right(); out.boxBottom = q.bottom();
+				out.hasGeom = true;
+			}
+			else {
+				out.boxLeft = (std::min)(out.boxLeft, q.left());
+				out.boxTop = (std::min)(out.boxTop, q.top());
+				out.boxRight = (std::max)(out.boxRight, q.right());
+				out.boxBottom = (std::max)(out.boxBottom, q.bottom());
+			}
+		}
+		rebuilt.push_back(std::move(out));
+	}
+	lines = std::move(rebuilt);
+	clearSelection();
+}
